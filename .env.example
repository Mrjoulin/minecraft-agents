# Any OpenAI-compatible endpoint works.
#
# --- OpenCode Go (default) ---
OPENCODE_API_KEY=oc_sk_...
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash
#
# --- GLM (Z.ai international / Zhipu bigmodel.cn) ---
# LLM_API_KEY is the generic key name; OPENCODE_API_KEY still works.
# LLM_API_KEY=<key from the Z.ai or bigmodel.cn console>
# LLM_BASE_URL=https://api.z.ai/api/paas/v4          # Z.ai international
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # Zhipu mainland
# LLM_MODEL=glm-4.6                                  # or glm-4.7 / glm-4.5-air / glm-4.5-flash
# Thinking models decide slower and cost more; make the bots snappy with:
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
#
# Offline mode: algorithmic driver instead of the model (no key needed).
# LLM_STUB=1
# Optional
# MC_HOST=127.0.0.1
# MC_PORT=25565
# MC_VERSION=1.21.4
