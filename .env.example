# Any OpenAI-compatible endpoint works. Default: OpenCode Go subscription.
OPENCODE_API_KEY=oc_sk_...
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash
# Offline mode: algorithmic driver instead of the model (no key needed).
# LLM_STUB=1
# Optional
# MC_HOST=127.0.0.1
# MC_PORT=25565
# MC_VERSION=1.21.4
